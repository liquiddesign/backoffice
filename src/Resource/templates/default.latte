{varType Backoffice\Resource\List\ListBuilder $list}
{varType array $rows}
{block content}
	<section class="bo-card">
		<div class="bo-card-head">
			<h2>{$total} {if $total === 1}záznam{elseif $total >= 2 && $total <= 4}záznamy{else}záznamů{/if}</h2>
		</div>
		<div n:if="$rows" class="bo-table-wrap">
			<table class="bo-table">
				<thead>
					<tr>
						<th n:foreach="$list->getColumns() as $column">{$column->label}</th>
					</tr>
				</thead>
				<tbody>
					<tr n:foreach="$rows as $row">
						<td n:foreach="$list->getColumns() as $column" n:class="$column->type === 'date' ? bo-mono">
							{if $column->type === Backoffice\Resource\List\Column::TYPE_MUTATIONS}
								{foreach $mutations as $mutation}
									{var $filled = false}
									{foreach $localizedColumns as $localized}
										{if (string) $row->getValue($localized, $mutation) !== ''}{var $filled = true}{/if}
									{/foreach}
									<span n:class="bo-pill, $filled ? bo-pill-brand">{$mutation|upper}</span>
								{/foreach}
							{else}
								{var $value = $row->getValue($column->name)}
								{if $column->type === Backoffice\Resource\List\Column::TYPE_DATE && $value}
									{var $value = ($value|date: $column->getFormat() ?? 'j. n. Y')}
								{/if}
								{if $column->isLink()}
									<a n:href="edit id => $row->getPK()">{$value}</a>
								{else}
									{$value}
								{/if}
							{/if}
						</td>
					</tr>
				</tbody>
			</table>
		</div>
		<div n:if="!$rows" class="bo-empty">Zatím žádné záznamy.</div>
		<nav n:if="$pages > 1" class="bo-pager" aria-label="Stránkování">
			<a n:if="$page > 1" class="bo-btn bo-btn-ghost" n:href="this page => $page - 1">‹ Předchozí</a>
			<span class="bo-muted">Strana {$page} z {$pages}</span>
			<a n:if="$page < $pages" class="bo-btn bo-btn-ghost" n:href="this page => $page + 1">Další ›</a>
		</nav>
	</section>
{/block}
