{* Pole formuláře agendy. Parametry: $form, $fields (list<Field>), $mutations. Volat uvnitř <form n:name>. *}
{varType Nette\Forms\Form $form}
{varType array $fields}
{varType array $mutations}
{foreach $fields as $field}
	{var $whenField = $field->getVisibleWhenField()}
	<div class="bo-field-wrap" n:attr="data-bo-when: $whenField !== null ? $form[$whenField]->getHtmlName(), data-bo-when-values: $whenField !== null ? json_encode($field->getVisibleWhenValues())">
	{if $field->isLocalized()}
		<fieldset class="bo-field bo-field-locale">
			<legend>{$field->label}{if $field->isRequired()} <span class="bo-req" aria-hidden="true">*</span>{/if}</legend>
			<div class="bo-locale-grid">
				{formContainer $field->name}
					{foreach $mutations as $mutation}
						<div class="bo-locale-item">
							<label n:name="$mutation" class="bo-locale-label"><span class="bo-pill">{$mutation|upper}</span></label>
							{if $field->type === Backoffice\Resource\Form\Field::TYPE_LOCALE_TEXTAREA}
								<textarea n:name="$mutation" n:class="bo-input, $formContainer[$mutation]->hasErrors() ? is-invalid"></textarea>
							{else}
								<input n:name="$mutation" n:class="bo-input, $formContainer[$mutation]->hasErrors() ? is-invalid">
							{/if}
							<span class="bo-field-error" n:ifcontent>{inputError $mutation}</span>
						</div>
					{/foreach}
				{/formContainer}
			</div>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</fieldset>
	{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_IMAGE}
		{var $imageUrl = ($imageUrls ?? [])[$field->name] ?? null}
		<div class="bo-field">
			<label n:name="$field->name">{$field->label}{if $field->isRequired()} <span class="bo-req" aria-hidden="true">*</span>{/if}</label>
			<div n:class="bo-image, $imageUrl ? has-image, $form[$field->name]->hasErrors() ? is-invalid" data-bo-image>
				<div class="bo-image-thumb">
					<img n:if="$imageUrl" src="{$imageUrl}" alt="" data-bo-image-preview>
					<img n:if="!$imageUrl" alt="" data-bo-image-preview hidden>
					<span n:if="!$imageUrl" class="bo-image-empty" data-bo-image-empty>Bez obrázku</span>
				</div>
				<div class="bo-image-drop">
					<input n:name="$field->name" class="bo-image-input">
					<span class="bo-image-text" data-bo-image-text>{if $imageUrl}Přetáhněte nový obrázek, nebo <u>vyberte</u>{else}Přetáhněte obrázek, nebo <u>vyberte</u>{/if}</span>
					<span class="bo-help">JPG, PNG, GIF nebo WebP; na webu se použije i WebP verze</span>
				</div>
			</div>
			<label n:if="$imageUrl" class="bo-check bo-image-remove"><input n:name="$field->name . Backoffice\Resource\Form\FormFactory::REMOVE_SUFFIX"> Odstranit obrázek (smaže se po uložení)</label>
			<span class="bo-field-error" n:ifcontent>{inputError $field->name}</span>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</div>
	{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_RELATION}
		<div class="bo-field">
			<label for="{$form[$field->name]->getHtmlId()}-search">{$field->label}{if $field->isRequired()} <span class="bo-req" aria-hidden="true">*</span>{/if}</label>
			<div class="bo-lookup" data-bo-lookup="{plink lookup! field => $field->name}">
				<input n:name="$field->name" type="hidden" data-bo-lookup-value>
				<input type="text" id="{$form[$field->name]->getHtmlId()}-search" n:class="bo-input, $form[$field->name]->hasErrors() ? is-invalid" value="{($relationLabels ?? [])[$field->name] ?? ''}" placeholder="Začněte psát a vyberte ze seznamu" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="{$form[$field->name]->getHtmlId()}-list" data-bo-lookup-input n:attr="disabled: $form[$field->name]->isDisabled()">
				<ul class="bo-lookup-list" id="{$form[$field->name]->getHtmlId()}-list" role="listbox" hidden data-bo-lookup-list></ul>
			</div>
			<span class="bo-field-error" n:ifcontent>{inputError $field->name}</span>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</div>
	{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_FILE}
		{var $file = ($fileInfo ?? [])[$field->name] ?? null}
		<div class="bo-field">
			<label n:name="$field->name">{$field->label}{if $field->isRequired()} <span class="bo-req" aria-hidden="true">*</span>{/if}</label>
			<div n:if="$file" class="bo-file-current">
				{Backoffice\Shell\Icons::get('file', 16)}
				{if $file[1]}<a href="{$file[1]}" target="_blank" rel="noopener">{$file[0]}</a>{else}<span>{$file[0]}</span> <span class="bo-field-warn">soubor na disku chybí</span>{/if}
				<span n:if="$file[2] !== null" class="bo-muted">{$file[2]|bytes}</span>
			</div>
			<div n:class="bo-image-drop, bo-file-drop, $form[$field->name]->hasErrors() ? is-invalid" data-bo-file>
				<input n:name="$field->name" class="bo-image-input">
				<span class="bo-image-text" data-bo-image-text>{if $file}Přetáhněte nový soubor, nebo <u>vyberte</u> — nahradí současný{else}Přetáhněte soubor, nebo <u>vyberte</u>{/if}</span>
			</div>
			<label n:if="$file && !$field->isRequired()" class="bo-check bo-image-remove"><input n:name="$field->name . Backoffice\Resource\Form\FormFactory::REMOVE_SUFFIX"> Odstranit soubor (smaže se po uložení)</label>
			<span class="bo-field-error" n:ifcontent>{inputError $field->name}</span>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</div>
	{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_CHECKBOX}
		<div class="bo-field">
			<label class="bo-check"><input n:name="$field->name"> {$field->label}</label>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</div>
	{else}
		<div class="bo-field">
			<label n:name="$field->name">{$field->label}{if $field->isRequired()} <span class="bo-req" aria-hidden="true">*</span>{/if}</label>
			{if $field->type === Backoffice\Resource\Form\Field::TYPE_TEXTAREA}
				<textarea n:name="$field->name" n:class="bo-input, $form[$field->name]->hasErrors() ? is-invalid"></textarea>
			{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_SELECT}
				<select n:name="$field->name" n:class="bo-input, $form[$field->name]->hasErrors() ? is-invalid"></select>
			{else}
				<input n:name="$field->name" n:class="bo-input, $field->type === 'date' ? bo-input-date, $form[$field->name]->hasErrors() ? is-invalid">
			{/if}
			<span class="bo-field-error" n:ifcontent>{inputError $field->name}</span>
			<span n:if="$field->type === Backoffice\Resource\Form\Field::TYPE_DATE" class="bo-field-warn" id="{$form[$field->name]->getHtmlId()}-warn" aria-live="polite"></span>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</div>
	{/if}
	</div>
{/foreach}
