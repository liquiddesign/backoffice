{* Pole formuláře agendy. Parametry: $form, $fields (list<Field>), $mutations. Volat uvnitř <form n:name>.
   Formátovaný text potřebuje $richText (Backoffice\Resource\Form\RichTextEditor) — dává ho presenter. *}
{varType Nette\Forms\Form $form}
{varType array $fields}
{varType array $mutations}
{foreach $fields as $field}
	{var $whenField = $field->getVisibleWhenField()}
	<div class="bo-field-wrap" n:attr="data-bo-when: $whenField !== null ? $form[$whenField]->getHtmlName(), data-bo-when-values: $whenField !== null ? json_encode($field->getVisibleWhenValues())">
	{if $field->isLocalized()}
		<fieldset class="bo-field bo-field-locale">
			<legend>{$field->label}{if $field->isRequired()} <span class="bo-req" aria-hidden="true">*</span>{/if}</legend>
			<div n:class="bo-locale-grid, $field->isRichText() ? is-stacked">
				{formContainer $field->name}
					{foreach $mutations as $mutation}
						<div class="bo-locale-item">
							<label n:name="$mutation" class="bo-locale-label"><span class="bo-pill">{$mutation|upper}</span></label>
							{if $field->isRichText()}
								{include richText, field: $field, mutation: $mutation, control: $formContainer[$mutation]}
							{else}
								{include textInput, field: $field, control: $formContainer[$mutation], mutation: $mutation}
							{/if}
							<span class="bo-field-error" n:ifcontent>{inputError $mutation}</span>
						</div>
					{/foreach}
				{/formContainer}
			</div>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</fieldset>
	{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_IMAGE}
		{var $imageUrl = ($imageUrls ?? [])[$field->name] ?? null}
		<div class="bo-field">
			<label n:name="$field->name">{$field->label}{if $field->isRequired()} <span class="bo-req" aria-hidden="true">*</span>{/if}</label>
			<div n:class="bo-image, $imageUrl ? has-image, $form[$field->name]->hasErrors() ? is-invalid" data-bo-image>
				<div class="bo-image-thumb">
					<img n:if="$imageUrl" src="{$imageUrl}" alt="" data-bo-image-preview>
					<img n:if="!$imageUrl" alt="" data-bo-image-preview hidden>
					<span n:if="!$imageUrl" class="bo-image-empty" data-bo-image-empty>Bez obrázku</span>
				</div>
				<div class="bo-image-drop">
					<input n:name="$field->name" class="bo-image-input">
					<span class="bo-image-text" data-bo-image-text>{if $imageUrl}Přetáhněte nový obrázek, nebo <u>vyberte</u>{else}Přetáhněte obrázek, nebo <u>vyberte</u>{/if}</span>
					<span class="bo-help">JPG, PNG, GIF nebo WebP; na webu se použije i WebP verze</span>
				</div>
			</div>
			<label n:if="$imageUrl" class="bo-check bo-image-remove"><input n:name="$field->name . Backoffice\Resource\Form\FormFactory::REMOVE_SUFFIX"> Odstranit obrázek (smaže se po uložení)</label>
			<span class="bo-field-error" n:ifcontent>{inputError $field->name}</span>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</div>
	{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_RELATION}
		<div class="bo-field">
			<label for="{$form[$field->name]->getHtmlId()}-search">{$field->label}{if $field->isRequired()} <span class="bo-req" aria-hidden="true">*</span>{/if}</label>
			<div class="bo-lookup" data-bo-lookup="{plink lookup! field => $field->name}">
				<input n:name="$field->name" type="hidden" data-bo-lookup-value>
				<input type="text" id="{$form[$field->name]->getHtmlId()}-search" n:class="bo-input, $form[$field->name]->hasErrors() ? is-invalid" value="{($relationLabels ?? [])[$field->name] ?? ''}" placeholder="Začněte psát a vyberte ze seznamu" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="{$form[$field->name]->getHtmlId()}-list" data-bo-lookup-input n:attr="disabled: $form[$field->name]->isDisabled()">
				<ul class="bo-lookup-list" id="{$form[$field->name]->getHtmlId()}-list" role="listbox" hidden data-bo-lookup-list></ul>
			</div>
			<span class="bo-field-error" n:ifcontent>{inputError $field->name}</span>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</div>
	{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_RELATIONS}
		{var $chips = ($relationLabels ?? [])[$field->name] ?? []}
		{var $disabled = $form[$field->name]->isDisabled()}
		<div class="bo-field">
			<label for="{$form[$field->name]->getHtmlId()}-search">{$field->label}{if $field->isRequired()} <span class="bo-req" aria-hidden="true">*</span>{/if}</label>
			<div n:class="bo-lookup, bo-lookup-multi, $form[$field->name]->hasErrors() ? is-invalid" data-bo-lookup="{plink lookup! field => $field->name}" data-bo-lookup-multi>
				<input n:name="$field->name" type="hidden" data-bo-lookup-value>
				<ul class="bo-chips" data-bo-chips aria-label="Vybráno">
					<li n:foreach="$chips as $key => $label" class="bo-chip" data-bo-chip="{$key}">
						<span>{$label}</span>
						<button n:if="!$disabled" type="button" class="bo-chip-remove" data-bo-chip-remove aria-label="Odebrat {$label}" title="Odebrat">&times;</button>
					</li>
				</ul>
				<input n:if="!$disabled" type="text" id="{$form[$field->name]->getHtmlId()}-search" class="bo-input" placeholder="Začněte psát a přidejte ze seznamu" autocomplete="off" role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="{$form[$field->name]->getHtmlId()}-list" data-bo-lookup-input>
				<ul class="bo-lookup-list" id="{$form[$field->name]->getHtmlId()}-list" role="listbox" hidden data-bo-lookup-list></ul>
			</div>
			<span class="bo-field-error" n:ifcontent>{inputError $field->name}</span>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</div>
	{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_FILE}
		{var $file = ($fileInfo ?? [])[$field->name] ?? null}
		<div class="bo-field">
			<label n:name="$field->name">{$field->label}{if $field->isRequired()} <span class="bo-req" aria-hidden="true">*</span>{/if}</label>
			<div n:if="$file" class="bo-file-current">
				{Backoffice\Shell\Icons::get('file', 16)}
				{if $file[1]}<a href="{$file[1]}" target="_blank" rel="noopener">{$file[0]}</a>{else}<span>{$file[0]}</span> <span class="bo-field-warn">soubor na disku chybí</span>{/if}
				<span n:if="$file[2] !== null" class="bo-muted">{$file[2]|bytes}</span>
			</div>
			<div n:class="bo-image-drop, bo-file-drop, $form[$field->name]->hasErrors() ? is-invalid" data-bo-file>
				<input n:name="$field->name" class="bo-image-input">
				<span class="bo-image-text" data-bo-image-text>{if $file}Přetáhněte nový soubor, nebo <u>vyberte</u> — nahradí současný{else}Přetáhněte soubor, nebo <u>vyberte</u>{/if}</span>
			</div>
			<label n:if="$file && !$field->isRequired()" class="bo-check bo-image-remove"><input n:name="$field->name . Backoffice\Resource\Form\FormFactory::REMOVE_SUFFIX"> Odstranit soubor (smaže se po uložení)</label>
			<span class="bo-field-error" n:ifcontent>{inputError $field->name}</span>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</div>
	{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_UPLOADS}
		<div class="bo-field">
			<label n:name="$field->name">{$field->label}{if $field->isRequired()} <span class="bo-req" aria-hidden="true">*</span>{/if}</label>
			<div n:class="bo-image-drop, bo-file-drop, $form[$field->name]->hasErrors() ? is-invalid" data-bo-file>
				<input n:name="$field->name" class="bo-image-input">
				<span class="bo-image-text" data-bo-image-text>Přetáhněte soubory, nebo <u>vyberte</u> — najednou nejvýš {Backoffice\Resource\Form\FormFactory::maxFileUploads()}</span>
			</div>
			<span class="bo-field-error" n:ifcontent>{inputError $field->name}</span>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</div>
	{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_ROWS}
		{include rows, field: $field, rows: ($formRows ?? [])[$field->name] ?? []}
	{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_CHECKBOX}
		<div class="bo-field">
			<label class="bo-check"><input n:name="$field->name"> {$field->label}</label>
			<span class="bo-field-error" n:ifcontent>{inputError $field->name}</span>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</div>
	{else}
		<div class="bo-field">
			<label n:name="$field->name">{$field->label}{if $field->isRequired()} <span class="bo-req" aria-hidden="true">*</span>{/if}</label>
			{if $field->isRichText()}
				{include richText, field: $field, mutation: null, control: $form[$field->name]}
			{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_TEXTAREA || $field->type === Backoffice\Resource\Form\Field::TYPE_TEXT}
				{include textInput, field: $field, control: $form[$field->name], mutation: null}
			{elseif $field->type === Backoffice\Resource\Form\Field::TYPE_SELECT}
				<select n:name="$field->name" n:class="bo-input, $form[$field->name]->hasErrors() ? is-invalid"></select>
			{else}
				<input n:name="$field->name" n:class="bo-input, $field->type === 'date' || $field->type === 'datetime' ? bo-input-date, $form[$field->name]->hasErrors() ? is-invalid">
			{/if}
			<span class="bo-field-error" n:ifcontent>{inputError $field->name}</span>
			<span n:if="$field->type === Backoffice\Resource\Form\Field::TYPE_DATE" class="bo-field-warn" id="{$form[$field->name]->getHtmlId()}-warn" aria-live="polite"></span>
			<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
		</div>
	{/if}
	</div>
{/foreach}

{define richText, Backoffice\Resource\Form\Field $field, ?string $mutation, Nette\Forms\Controls\BaseControl $control}
	{var $uploadUrl = $field->getRichTextUploadDirectory() !== null ? $presenter->link('//richTextUpload!', [field => $field->name]) : null}
	{$control->getControlPart()->addAttributes(Backoffice\Resource\Form\FormFactory::richTextAttributes($field, $mutation, $richText ?? null, $control->hasErrors(), $uploadUrl))}
{/define}

{* Textové pole (i jazykové): třída, počítadlo znaků (Field::counter), pole na kód (Field::code) a pevný text před polem (Field::prefix). *}
{define textInput, Backoffice\Resource\Form\Field $field, Nette\Forms\Controls\BaseControl $control, ?string $mutation}
	{var $prefix = $field->getPrefix($mutation)}
	{var $input = $control->getControl()->addClass('bo-input')->addClass($control->hasErrors() ? 'is-invalid' : null)}
	{if $field->getCounter() !== null}{do $input->setAttribute('data-bo-counter', $field->getCounter())}{/if}
	{if $field->isCode()}{do $input->addClass('bo-code')->setAttribute('spellcheck', 'false')->setAttribute('autocapitalize', 'off')->setAttribute('autocomplete', 'off')}{/if}
	{if $prefix !== null}
		<div class="bo-input-group"><span class="bo-input-prefix">{$prefix}</span>{$input}</div>
	{else}
		{$input}
	{/if}
{/define}

{* Vnořený seznam (FormBuilder::rows()): tabulka řádků z ResourceDefinition::formRows(), pole řádků
   v kontejneru pole → klíč řádku. S rowsSortableBy() řádky jdou přetáhnout za úchyt (nebo šipkami). *}
{define rows, Backoffice\Resource\Form\Field $field, array $rows}
	{var $sort = $field->getRowSortColumn()}
	<div class="bo-field bo-rows">
		<span class="bo-rows-title">{$field->label}</span>
		{if $rows}
			<div class="bo-table-wrap">
				<table class="bo-table bo-rows-table">
					<thead>
						<tr>
							<th n:if="$sort" class="bo-th-grip"><span class="bo-sr-only">Přesunout</span></th>
							<th>Název</th>
							<th n:foreach="$field->getRowColumns() as $column" n:class="$column['type'] !== text ? bo-th-narrow">{$column['label']}</th>
						</tr>
					</thead>
					<tbody n:attr="data-bo-rows-sortable: $sort !== null">
						{formContainer $field->name}
						{foreach $rows as $row}
							{formContainer $row->key}
							<tr data-bo-row>
								<td n:if="$sort" class="bo-td-grip"><button type="button" class="bo-grip" data-bo-grip aria-label="Přesunout {$row->label} (šipky nahoru a dolů)" title="Přetažením změníte pořadí">{Backoffice\Shell\Icons::get('grip', 16)}</button></td>
								<td>
									<div class="bo-rows-label">
										{var $thumb = $row->image !== null ? $presenter->imageUrl($row->image[0], $row->image[1]) : null}
										<img n:if="$thumb" src="{$thumb}" alt="" class="bo-rows-thumb" loading="lazy">
										<span>
											{if $row->link}<a href="{plink $row->link, ...$row->linkArgs}">{$row->label}</a>{else}{$row->label}{/if}
											<small n:if="$row->note" class="bo-muted">{$row->note}</small>
										</span>
									</div>
								</td>
								{foreach $field->getRowColumns() as $name => $column}
									<td>
										{if $column['type'] === Backoffice\Resource\Form\Field::ROW_CHECKBOX}
											<input n:name="$name" aria-label="{$column['label']} — {$row->label}">
										{elseif $column['type'] === Backoffice\Resource\Form\Field::ROW_IMAGE}
											<input n:name="$name" class="bo-row-upload" aria-label="{$column['label']} — {$row->label}">
										{elseif $column['type'] === Backoffice\Resource\Form\Field::ROW_INTEGER}
											<input n:name="$name" n:class="bo-input, bo-cell-input, bo-cell-number, $formContainer[$name]->hasErrors() ? is-invalid" aria-label="{$column['label']} — {$row->label}" n:attr="data-bo-rows-priority: $name === $sort">
										{else}
											<input n:name="$name" n:class="bo-input, bo-cell-input, $formContainer[$name]->hasErrors() ? is-invalid" placeholder="{$column['placeholder']}" aria-label="{$column['label']} — {$row->label}">
										{/if}
										<span class="bo-field-error" n:ifcontent>{inputError $name}</span>
									</td>
								{/foreach}
							</tr>
							{/formContainer}
						{/foreach}
						{/formContainer}
					</tbody>
				</table>
			</div>
		{else}
			<p class="bo-muted">{$field->getRowsEmptyText()}</p>
		{/if}
		<p n:if="$field->getDescription()" class="bo-help">{$field->getDescription()}</p>
	</div>
{/define}
