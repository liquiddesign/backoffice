{varType array $fields}
{varType StORM\Entity $entity}
{block content}
	<div class="bo-flash bo-flash-info" role="status">
		<span>Náhled záznamu. Úpravy přijdou s formulářem (etapa 1) — do té doby se upravuje ve staré administraci.</span>
	</div>
	<section class="bo-card">
		<div class="bo-card-head"><h2>Údaje</h2></div>
		<div class="bo-card-body">
			<dl class="bo-dl">
				{foreach $fields as $field}
					<dt>{$field->label}</dt>
					<dd>
						{if $field->isLocalized()}
							{foreach $mutations as $mutation}
								<div><span class="bo-pill">{$mutation|upper}</span> {$entity->getValue($field->name, $mutation) ?: '—'}</div>
							{/foreach}
						{else}
							{$entity->getValue($field->name) ?? '—'}
						{/if}
					</dd>
				{/foreach}
			</dl>
		</div>
	</section>
{/block}
